# The FastAPI backend (medconnect-backend). The browser calls /api/* on this site and Next.js
# proxies it here, so this is read by the Next.js server at build/start, not by the browser.
# Restart `npm run dev` after changing it.
#   Deployed (AWS EC2):  http://47.129.242.10:8000
#   Local backend:       http://127.0.0.1:8000   (127.0.0.1, not localhost: uvicorn binds IPv4 only)
BACKEND_URL=http://47.129.242.10:8000

# Optional: call the backend directly from the browser instead of through the /api proxy.
# Only works when the frontend and backend are both http, or both https.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Must match the backend APP_TIMEZONE: slot dates/times are clinic wall-clock values.
NEXT_PUBLIC_CLINIC_TIMEZONE=Asia/Karachi
